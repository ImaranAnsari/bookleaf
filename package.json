{
  "name": "bookleaf-author-portal",
  "version": "1.0.0",
  "description": "BookLeaf Publishing - Author Support & Communication Portal",
  "main": "server/src/index.ts",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "cd client && npm run dev",
    "build:client": "cd client && npm run build",
    "build:server": "tsc -p server/tsconfig.json",
    "build": "npm run build:client && npm run build:server",
    "start": "NODE_ENV=production tsx server/src/index.ts",
    "seed": "tsx server/src/db/seed.ts",
    "test": "tsx server/src/testRunner.ts"
  },
  "keywords": [
    "bookleaf",
    "publishing",
    "author-portal",
    "support",
    "ai",
    "helpdesk"
  ],
  "author": "BookLeaf Engineering Candidate",
  "license": "UNLICENSED",
  "dependencies": {
    "@google/genai": "^0.1.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.85.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.4",
    "@types/swagger-ui-express": "^4.1.7",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
